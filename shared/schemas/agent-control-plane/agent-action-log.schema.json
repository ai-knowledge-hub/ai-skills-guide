{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.ai-knowledge-hub.org/schemas/agent-control-plane/agent-action-log.schema.json",
  "title": "Agent Control Plane Action Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "tenant_id", "actor_id", "executor_id", "grant_id", "claim_id",
    "decision_id", "approval_id", "action_id", "agent_run_id", "capability",
    "capability_version", "target", "inputs_hash", "outputs_hash", "status",
    "provider_receipt_hash", "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "control-plane.action-record/v1"},
    "record_id": {"type": "string", "pattern": "^actrec_[a-f0-9]{32}$"},
    "tenant_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "actor_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "executor_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "grant_id": {"type": "string", "pattern": "^grant_[a-f0-9]{32}$"},
    "claim_id": {"type": "string", "pattern": "^claim_[a-f0-9]{32}$"},
    "decision_id": {"type": "string", "pattern": "^pdec_[a-f0-9]{32}$"},
    "approval_id": {"type": ["string", "null"], "pattern": "^apr_[a-f0-9]{32}$"},
    "action_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "agent_run_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "capability": {"type": "string", "minLength": 2, "maxLength": 128},
    "capability_version": {"type": "string", "minLength": 2, "maxLength": 128},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "account_id", "resource_type", "resource_id"],
      "properties": {
        "provider": {"type": "string", "minLength": 2, "maxLength": 128},
        "account_id": {"type": "string", "minLength": 2, "maxLength": 128},
        "resource_type": {"type": "string", "minLength": 2, "maxLength": 128},
        "resource_id": {"type": "string", "minLength": 2, "maxLength": 128}
      }
    },
    "inputs_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "outputs_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "status": {"enum": ["executing", "executed", "failed", "cancelled"]},
    "provider_receipt_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
