{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.ai-knowledge-hub.org/schemas/registry-index-v1.2.schema.json",
  "title": "Skills Registry Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "generated_at",
    "skills"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "1.2"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "skills": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "category",
          "latest",
          "versions",
          "runtimes",
          "tags",
          "readiness",
          "usability",
          "security_reviewed",
          "deprecated"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "1.1",
              "2.0",
              "2.1"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "category": {
            "type": "string",
            "minLength": 3
          },
          "latest": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/version_entry"
            }
          },
          "runtimes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "codex",
                "claude",
                "generic"
              ]
            },
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
            },
            "uniqueItems": true
          },
          "readiness": {
            "type": "string",
            "enum": [
              "experimental",
              "reviewed",
              "deprecated"
            ]
          },
          "security_reviewed": {
            "type": "boolean"
          },
          "deprecated": {
            "type": "boolean"
          },
          "replaced_by": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
          },
          "operational": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "connected_system": {
                "type": "string",
                "minLength": 2
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3
                },
                "uniqueItems": true
              },
              "auth_required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2
                },
                "uniqueItems": true
              },
              "access_level": {
                "type": "string"
              },
              "trust_boundary": {
                "type": "string"
              },
              "approval_boundary": {
                "type": "string",
                "minLength": 5
              },
              "role": {
                "type": "string",
                "minLength": 3
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3
                },
                "uniqueItems": true
              },
              "autonomy_level": {
                "type": "string"
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3
                },
                "uniqueItems": true
              },
              "use_when": {
                "type": "string",
                "minLength": 5
              },
              "execution_mode": {
                "type": "string"
              }
            }
          },
          "usability": {
            "$ref": "#/$defs/registry_usability"
          },
          "execution": {
            "$ref": "#/$defs/execution"
          },
          "artifact": {
            "$ref": "#/$defs/artifact"
          },
          "authentication": {
            "$ref": "#/$defs/authentication"
          },
          "verification": {
            "$ref": "#/$defs/registry_verification"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
                },
                "uniqueItems": true
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
                },
                "uniqueItems": true
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "apis": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "mcp_servers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "includes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
                },
                "uniqueItems": true
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
                },
                "uniqueItems": true
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
                },
                "uniqueItems": true
              },
              "hooks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
                },
                "uniqueItems": true
              },
              "approvals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "deprecated": {
                  "const": true
                }
              },
              "required": [
                "deprecated"
              ]
            },
            "then": {
              "required": [
                "replaced_by"
              ]
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "schema_version": {
                      "pattern": "^2\\."
                    }
                  },
                  "required": [
                    "schema_version"
                  ]
                },
                {
                  "required": [
                    "execution"
                  ]
                },
                {
                  "required": [
                    "artifact"
                  ]
                },
                {
                  "required": [
                    "authentication"
                  ]
                },
                {
                  "required": [
                    "verification"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "schema_version",
                "execution",
                "artifact",
                "authentication",
                "verification"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "registry_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "last_verified_at"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "last_verified_at": {
          "$ref": "#/$defs/last_verified_at"
        }
      }
    },
    "registry_usability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "execution",
        "source"
      ],
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "usable-now",
            "setup-required",
            "not-verified",
            "template-only",
            "documentation-only"
          ]
        },
        "execution": {
          "type": "string",
          "enum": [
            "instructions",
            "local-tool",
            "remote-integration",
            "integration-template",
            "orchestrator",
            "bundle",
            "documentation"
          ]
        },
        "requires_setup": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        },
        "quickstart": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "executable_helpers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entrypoint",
              "availability",
              "execution",
              "limitations"
            ],
            "properties": {
              "entrypoint": {
                "type": "string",
                "minLength": 3
              },
              "availability": {
                "type": "string",
                "enum": [
                  "usable-now",
                  "setup-required",
                  "not-verified"
                ]
              },
              "execution": {
                "type": "string",
                "const": "local-tool"
              },
              "limitations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "quickstart": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300
              }
            }
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "declared",
            "inferred"
          ]
        }
      }
    },
    "version_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "released_at",
        "manifest_url",
        "artifact_url",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "released_at": {
          "type": "string",
          "format": "date-time"
        },
        "manifest_url": {
          "type": "string",
          "format": "uri"
        },
        "artifact_url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "supported_platforms",
        "supported_runtimes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "instructions",
            "script",
            "cli",
            "mcp-server",
            "service",
            "orchestrator",
            "bundle",
            "integration-template"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "healthcheck": {
          "$ref": "#/$defs/check"
        },
        "smoke_test": {
          "$ref": "#/$defs/check"
        },
        "supported_platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "linux",
              "macos",
              "windows",
              "web"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supported_runtimes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "script",
                  "cli",
                  "mcp-server",
                  "service",
                  "orchestrator"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command",
              "smoke_test"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "mcp-server",
                  "service"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "healthcheck"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "instructions",
                  "bundle",
                  "integration-template"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "healthcheck"
                  ]
                },
                {
                  "required": [
                    "smoke_test"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "script",
                  "cli",
                  "orchestrator"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "healthcheck"
              ]
            }
          }
        }
      ]
    },
    "check": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_contained",
        "dependency_lock",
        "checksums",
        "sbom"
      ],
      "properties": {
        "self_contained": {
          "type": "boolean"
        },
        "dependency_lock": {
          "$ref": "#/$defs/artifact_file"
        },
        "checksums": {
          "$ref": "#/$defs/artifact_file"
        },
        "sbom": {
          "$ref": "#/$defs/artifact_file"
        }
      }
    },
    "artifact_file": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "methods",
        "credential_bindings",
        "scopes",
        "credential_storage",
        "validation",
        "revocation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "api-key",
              "bearer-token",
              "oauth-authorization-code-pkce",
              "oauth-device-flow",
              "oauth-client-credentials",
              "service-account",
              "workload-identity",
              "brokered",
              "custom"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "credential_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$",
            "description": "Non-secret name resolved by the runtime credential store."
          },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "setup_url": {
          "type": "string",
          "format": "uri"
        },
        "credential_storage": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "validation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "revocation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "none"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "methods": {
                "const": [
                  "none"
                ]
              },
              "credential_bindings": {
                "maxItems": 0
              },
              "scopes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "optional",
                  "required"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "methods": {
                "not": {
                  "contains": {
                    "const": "none"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "required"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "credential_bindings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
