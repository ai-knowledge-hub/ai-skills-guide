{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.ai-knowledge-hub.org/schemas/manifest-contract-v2.schema.json",
  "title": "Manifest execution, artifact, authentication, and verification contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution", "artifact", "authentication", "verification"],
  "properties": {
    "execution": { "$ref": "#/$defs/execution" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "authentication": { "$ref": "#/$defs/authentication" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "last_verified_at"],
      "properties": {
        "evidence": { "$ref": "#/$defs/evidence" },
        "last_verified_at": { "$ref": "#/$defs/last_verified_at" }
      }
    }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "supported_platforms", "supported_runtimes"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "instructions",
            "script",
            "cli",
            "mcp-server",
            "service",
            "orchestrator",
            "bundle",
            "integration-template"
          ]
        },
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "healthcheck": { "$ref": "#/$defs/check" },
        "smoke_test": { "$ref": "#/$defs/check" },
        "supported_platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["linux", "macos", "windows", "web"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supported_runtimes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["script", "cli", "mcp-server", "service", "orchestrator"]
              }
            },
            "required": ["kind"]
          },
          "then": { "required": ["command", "smoke_test"] }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["mcp-server", "service"] } },
            "required": ["kind"]
          },
          "then": { "required": ["healthcheck"] }
        },
        {
          "if": {
            "properties": {
              "kind": { "enum": ["instructions", "bundle", "integration-template"] }
            },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["command"] },
                { "required": ["healthcheck"] },
                { "required": ["smoke_test"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["script", "cli", "orchestrator"] } },
            "required": ["kind"]
          },
          "then": { "not": { "required": ["healthcheck"] } }
        }
      ]
    },
    "check": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self_contained", "dependency_lock", "checksums", "sbom"],
      "properties": {
        "self_contained": { "type": "boolean" },
        "dependency_lock": { "$ref": "#/$defs/artifact_file" },
        "checksums": { "$ref": "#/$defs/artifact_file" },
        "sbom": { "$ref": "#/$defs/artifact_file" },
        "provenance": { "$ref": "#/$defs/artifact_file" }
      }
    },
    "artifact_file": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        { "type": "null" }
      ]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "methods",
        "credential_bindings",
        "scopes",
        "credential_storage",
        "validation",
        "revocation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "optional", "required"]
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "api-key",
              "bearer-token",
              "oauth-authorization-code-pkce",
              "oauth-device-flow",
              "oauth-client-credentials",
              "service-account",
              "workload-identity",
              "brokered",
              "custom"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "credential_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$",
            "description": "Non-secret name resolved by the runtime credential store."
          },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "setup_url": { "type": "string", "format": "uri" },
        "credential_storage": { "type": "string", "minLength": 3, "maxLength": 240 },
        "validation": { "type": "string", "minLength": 3, "maxLength": 240 },
        "revocation": { "type": "string", "minLength": 3, "maxLength": 240 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "none" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "methods": { "const": ["none"] },
              "credential_bindings": { "maxItems": 0 },
              "scopes": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["optional", "required"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "methods": {
                "not": { "contains": { "const": "none" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "required" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "credential_bindings": { "minItems": 1 } }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "minItems": 1,
      "uniqueItems": true
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
