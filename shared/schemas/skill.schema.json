{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.ai-knowledge-hub.org/schemas/skill.schema.json",
  "title": "Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "version",
    "released_at",
    "category",
    "tags",
    "license",
    "author",
    "runtimes",
    "entrypoints"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "authentication": {
      "$ref": "#/$defs/authentication"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "description": "Canonical ID in category/slug format."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "enum": [
        "marketing-tools/ads-ops",
        "marketing-tools/creative-ops",
        "marketing-tools/measurement",
        "marketing-tools/seo-sem",
        "marketing-tools/lifecycle-crm",
        "marketing-tools/compliance",
        "adtech/analytics-engineering",
        "adtech/compliance",
        "adtech/activation",
        "adtech/other",
        "engineering/code-maintenance",
        "engineering/testing-quality",
        "engineering/pr-review",
        "security/prompt-safety",
        "security/supply-chain",
        "security/runtime-hardening",
        "agentops/harness-evolution",
        "agentops/harness-governance",
        "agentops/harness-evaluation"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 2
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "codex",
          "claude",
          "generic"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_md"
      ],
      "properties": {
        "skill_md": {
          "type": "string",
          "default": "SKILL.md"
        },
        "readme": {
          "type": "string",
          "default": "README.md"
        },
        "tests": {
          "type": "string",
          "default": "tests/test-prompts.md"
        },
        "scripts_dir": {
          "type": "string",
          "default": "scripts"
        },
        "examples_dir": {
          "type": "string",
          "default": "examples"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "apis": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_when": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "analysis-only",
            "read-only-local-inspection",
            "may-run-local-verification",
            "may-propose-edits"
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "approval_boundary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240
        }
      }
    },
    "usability": {
      "$ref": "#/$defs/usability"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_min_prompts": {
          "type": "integer",
          "minimum": 1
        },
        "deterministic_scripts": {
          "type": "boolean"
        },
        "security_reviewed": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "last_verified_at": {
          "$ref": "#/$defs/last_verified_at"
        }
      }
    },
    "deprecated": {
      "type": "boolean",
      "default": false
    },
    "replaced_by": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    }
  },
  "$defs": {
    "usability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "usable-now",
            "setup-required",
            "template-only",
            "documentation-only"
          ]
        },
        "execution": {
          "type": "string",
          "enum": [
            "instructions",
            "local-tool",
            "remote-integration",
            "integration-template",
            "orchestrator",
            "bundle",
            "documentation"
          ]
        },
        "requires_setup": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        },
        "quickstart": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "supported_platforms",
        "supported_runtimes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "instructions",
            "script",
            "cli",
            "mcp-server",
            "service",
            "orchestrator",
            "bundle",
            "integration-template"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "healthcheck": {
          "$ref": "#/$defs/check"
        },
        "smoke_test": {
          "$ref": "#/$defs/check"
        },
        "supported_platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "linux",
              "macos",
              "windows",
              "web"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supported_runtimes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "script",
                  "cli",
                  "mcp-server",
                  "service",
                  "orchestrator"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command",
              "smoke_test"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "mcp-server",
                  "service"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "healthcheck"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "instructions",
                  "bundle",
                  "integration-template"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "healthcheck"
                  ]
                },
                {
                  "required": [
                    "smoke_test"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "script",
                  "cli",
                  "orchestrator"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "healthcheck"
              ]
            }
          }
        }
      ]
    },
    "check": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_contained",
        "dependency_lock",
        "checksums",
        "sbom"
      ],
      "properties": {
        "self_contained": {
          "type": "boolean"
        },
        "dependency_lock": {
          "$ref": "#/$defs/artifact_file"
        },
        "checksums": {
          "$ref": "#/$defs/artifact_file"
        },
        "sbom": {
          "$ref": "#/$defs/artifact_file"
        }
      }
    },
    "artifact_file": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "methods",
        "credential_bindings",
        "scopes",
        "credential_storage",
        "validation",
        "revocation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "api-key",
              "bearer-token",
              "oauth-authorization-code-pkce",
              "oauth-device-flow",
              "oauth-client-credentials",
              "service-account",
              "workload-identity",
              "brokered",
              "custom"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "credential_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$",
            "description": "Non-secret name resolved by the runtime credential store."
          },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "setup_url": {
          "type": "string",
          "format": "uri"
        },
        "credential_storage": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "validation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "revocation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "none"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "methods": {
                "const": [
                  "none"
                ]
              },
              "credential_bindings": {
                "maxItems": 0
              },
              "scopes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "optional",
                  "required"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "methods": {
                "not": {
                  "contains": {
                    "const": "none"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "required"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "credential_bindings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deprecated": {
            "const": true
          }
        },
        "required": [
          "deprecated"
        ]
      },
      "then": {
        "required": [
          "replaced_by"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "schema_version"
            ]
          },
          {
            "required": [
              "execution"
            ]
          },
          {
            "required": [
              "artifact"
            ]
          },
          {
            "required": [
              "authentication"
            ]
          },
          {
            "properties": {
              "verification": {
                "anyOf": [
                  {
                    "required": [
                      "evidence"
                    ]
                  },
                  {
                    "required": [
                      "last_verified_at"
                    ]
                  }
                ]
              }
            },
            "required": [
              "verification"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "schema_version",
          "execution",
          "artifact",
          "authentication",
          "verification"
        ],
        "properties": {
          "verification": {
            "required": [
              "evidence",
              "last_verified_at"
            ]
          }
        }
      }
    }
  ]
}
