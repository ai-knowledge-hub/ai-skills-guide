{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.ai-knowledge-hub.org/schemas/ad-platform/change-plan.schema.json",
  "title": "Governed Ad Platform Change Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "action_id", "provider", "account_id", "resource_type", "resource_id", "operation", "proposed_diff", "generated_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "ad-platform.change-plan/v2"},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "provider": {"enum": ["google_ads", "dv360"]},
    "account_id": {"type": "string", "pattern": "^[1-9][0-9]{3,29}$"},
    "resource_type": {"enum": ["campaign", "campaign_budget", "ad_group", "line_item"]},
    "resource_id": {"type": "string", "pattern": "^[1-9][0-9]{3,29}$"},
    "operation": {"enum": ["set_status", "set_budget_micros", "set_bid_micros"]},
    "proposed_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "from", "to"],
      "properties": {
        "field": {"enum": ["status", "budget_micros", "bid_micros"]},
        "from": {"oneOf": [{"enum": ["ENABLED", "PAUSED"]}, {"type": "integer", "minimum": 1, "maximum": 1000000000000}]},
        "to": {"oneOf": [{"enum": ["ENABLED", "PAUSED"]}, {"type": "integer", "minimum": 1, "maximum": 1000000000000}]}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
