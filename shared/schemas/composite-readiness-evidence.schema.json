{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.ai-knowledge-hub.org/schemas/composite-readiness-evidence.schema.json",
  "title": "Skills Hub composite provider readiness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "entry_id",
    "entry_version",
    "artifact_sha256",
    "dependency_lock_sha256",
    "runtime",
    "platform",
    "environment_id",
    "configuration_class",
    "coverage_state",
    "workflow_target_fingerprint",
    "provider_observations",
    "observed_at",
    "expires_at",
    "result",
    "promotion_eligible"
  ],
  "properties": {
    "schema_version": { "const": "skills-hub.composite-readiness-evidence/v1" },
    "contract_id": { "const": "operational-readiness" },
    "contract_version": { "const": "1.0.3" },
    "entry_id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
    "entry_version": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependency_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime": { "enum": ["codex", "claude", "generic"] },
    "platform": { "enum": ["linux", "macos", "windows"] },
    "environment_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "configuration_class": { "const": "authenticated-composite" },
    "coverage_state": { "enum": ["complete", "partial", "unavailable"] },
    "workflow_target_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/provider_observation" }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "result": { "enum": ["passed", "failed"] },
    "promotion_eligible": { "type": "boolean" },
    "failure_reason": { "type": "string", "minLength": 1, "maxLength": 160 }
  },
  "$defs": {
    "provider_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "tool_version", "requirement", "access", "state"],
      "properties": {
        "tool_id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
        "tool_version": { "type": "string", "minLength": 1 },
        "requirement": { "enum": ["required", "optional"] },
        "access": { "enum": ["read-only", "read-write"] },
        "state": { "enum": ["ready", "unavailable"] },
        "target_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "failure_reason": { "type": "string", "minLength": 1, "maxLength": 160 }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
          "then": {
            "required": ["target_fingerprint", "evidence_sha256", "observed_at", "expires_at"],
            "not": { "required": ["failure_reason"] }
          },
          "else": {
            "required": ["failure_reason"],
            "not": {
              "anyOf": [
                { "required": ["target_fingerprint"] },
                { "required": ["evidence_sha256"] },
                { "required": ["observed_at"] },
                { "required": ["expires_at"] }
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "failed" } }, "required": ["result"] },
      "then": {
        "required": ["failure_reason"],
        "properties": {
          "coverage_state": { "const": "unavailable" },
          "promotion_eligible": { "const": false }
        }
      },
      "else": { "not": { "required": ["failure_reason"] } }
    },
    {
      "if": { "properties": { "coverage_state": { "const": "partial" } }, "required": ["coverage_state"] },
      "then": { "properties": { "promotion_eligible": { "const": false } } }
    },
    {
      "if": { "properties": { "promotion_eligible": { "const": true } }, "required": ["promotion_eligible"] },
      "then": {
        "properties": {
          "result": { "const": "passed" },
          "coverage_state": { "const": "complete" }
        }
      }
    }
  ]
}
