{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.ai-knowledge-hub.org/schemas/runtime-package.schema.json",
  "title": "Compiled runtime package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "source_lock", "package", "registrations"],
  "properties": {
    "schema_version": {
      "const": "skills-hub.runtime-package/v1"
    },
    "runtime": {
      "enum": ["codex", "claude", "generic"]
    },
    "source_lock": {
      "const": "dependencies.lock.json"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "registrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "agents", "mcp_servers", "config", "hooks"],
      "properties": {
        "skills": { "$ref": "#/$defs/registrations" },
        "agents": { "$ref": "#/$defs/registrations" },
        "mcp_servers": { "$ref": "#/$defs/registrations" },
        "config": { "$ref": "#/$defs/registrations" },
        "hooks": { "$ref": "#/$defs/registrations" }
      }
    }
  },
  "$defs": {
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "enforcement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^\\./" },
          "enforcement": { "enum": ["native", "advisory"] },
          "reason": { "type": "string", "minLength": 1 },
          "names": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "enforcement": { "const": "advisory" } },
              "required": ["enforcement"]
            },
            "then": { "required": ["reason"] }
          }
        ]
      }
    }
  }
}
